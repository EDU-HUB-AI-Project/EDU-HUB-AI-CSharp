IGNORE
# =============================================
#  C# WinForms - Visual Studio .gitignore
# =============================================
 
# -----------------------------------------------
# Visual Studio 빌드 결과물
# -----------------------------------------------
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
 
# -----------------------------------------------
# Visual Studio 자동 생성 파일
# -----------------------------------------------
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
 
# -----------------------------------------------
# NuGet 패키지 (packages 폴더 / 복원 가능)
# -----------------------------------------------
packages/
*.nupkg
*.snupkg
**/[Pp]ackages/
!**/[Pp]ackages/build/
project.lock.json
project.fragment.lock.json
artifacts/
 
# NuGet v3
*.nuget.props
*.nuget.targets
 
# -----------------------------------------------
# .NET 빌드/게시 결과물
# -----------------------------------------------
publish/
**/publish/
*.pubxml
*.pubxml.user
 
# -----------------------------------------------
# 테스트 결과
# -----------------------------------------------
TestResults/
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
 
# -----------------------------------------------
# Roslyn 캐시
# -----------------------------------------------
*.SourceLink.cache
 
# -----------------------------------------------
# Windows 관련
# -----------------------------------------------
Thumbs.db
Thumbs.db:encdata
Desktop.ini
$RECYCLE.BIN/
*.lnk
 
# -----------------------------------------------
# 기타 IDE / 에디터
# -----------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
 
# -----------------------------------------------
# 민감 정보 / 로컬 설정 (프로젝트에 맞게 수정)
# -----------------------------------------------
appsettings.local.json
config.local.json
*.env
secrets.json
EDU_HUB AI/config.json
config.json